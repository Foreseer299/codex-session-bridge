{
  "name": "codex-session-bridge",
  "version": "0.2.0",
  "description": "A native Paseo plugin for shared VPS Codex sessions with automatic setup.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin/*.cjs",
    "scripts/*.py",
    "patches/*.patch",
    "patches/manifest.json",
    "docs/*.md",
    "tests/*.py",
    "tests/*.cjs",
    "licenses/*",
    "README.md",
    "NOTICE",
    "LICENSE",
    "npm-shrinkwrap.json",
    "server/*.cjs",
    "scripts/*.cjs",
    "index.server.ts",
    "paseo-plugin.json"
  ],
  "scripts": {
    "watch": "node bin/watch.cjs",
    "sync": "python3 scripts/sync.py",
    "test": "node tests/bridge.cjs && node --test tests/plugin.test.cjs && python3 -m unittest discover -s tests -v"
  },
  "dependencies": {
    "@getpaseo/client": "0.15.3",
    "ws": "8.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Foreseer299/codex-session-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Foreseer299/codex-session-bridge/issues"
  },
  "bin": {
    "codex-session-bridge": "bin/install-plugin.cjs"
  }
}
